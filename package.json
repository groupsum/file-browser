{
  "name": "file-browser-workspace",
  "version": "0.1.0",
  "description": "SSOT-governed Groupsum file browser workspace.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck",
    "ssot:validate": "uv run ssot validate ."
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "minimatch@10.2.5>brace-expansion": "5.0.12",
      "browserslist@>=4 <4.28.7": "4.28.7",
      "postcss@>=8 <8.5.23": "8.5.23"
    }
  }
}
